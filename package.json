{
  "name": "ai-dev-workflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Workspace for the ai-dev-requirements MCP server and development workflow tools",
  "type": "module",
  "scripts": {
    "build": "pnpm build:mcp && pnpm build:workflow-plugin && pnpm build:dashboard",
    "build:dashboard": "pnpm --filter ones-task-dashboard build",
    "build:mcp": "pnpm --filter ai-dev-requirements build",
    "build:workflow-plugin": "tsdown --config plugins/codex-workflow-assistant/tsdown.config.ts",
    "build:task-splitter": "pnpm --filter @ai-dev-workflow/task-splitter-core build && pnpm --filter ones-task-splitter build",
    "start": "pnpm --filter ai-dev-requirements start",
    "dev": "tsx src/index.ts",
    "dev:dashboard": "pnpm --filter ones-task-dashboard dev",
    "start:dashboard": "pnpm --filter ones-task-dashboard start",
    "start:dashboard:orca": "tsx scripts/start-ones-dashboard.ts",
    "inspect": "npx @modelcontextprotocol/inspector node ./packages/ai-dev-requirements/dist/index.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:task-splitter": "pnpm --filter @ai-dev-workflow/task-splitter-core test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "entities": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "ot-json1": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
