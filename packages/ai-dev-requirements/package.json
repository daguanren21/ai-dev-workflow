{
  "name": "ai-dev-requirements",
  "version": "0.5.0",
  "description": "MCP server for fetching and classifying ONES requirements, tasks, and defects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "requirements-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node scripts/sync-skills.mjs",
    "start": "node ./dist/index.mjs",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "requirements",
    "ones",
    "ai-dev-workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daguanren21/ai-dev-workflow"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "entities": "^8.0.0",
    "ipaddr.js": "^2.5.0",
    "ot-json1": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
